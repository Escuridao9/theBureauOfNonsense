    {
      "id": "parking",
      "name": "Department of Impossible Vehicles",
      "permit": "Rooftop parking",
      "form": "RP-04",
      "date": "1984-10-07",
      "intro": "Rooftops are not a public right. Even for creatures who can fly.",
      "memo": "Being able to land somewhere does not constitute permission to land there.",
      "briefingTitle": "Welcome to the fifth floor.",
      "briefing": "Your first assignment is rooftop parking. Expect large vehicles, larger egos, and fireproofing certificates. The regulations are on your left. Please familiarise yourself with them before anything lands.",
      "fields": [
        {
          "key": "requestedZone",
          "label": "Requested parking zone",
          "format": "text"
        },
        {
          "key": "weight",
          "label": "Declared weight",
          "format": "number",
          "unit": "kg"
        },
        {
          "key": "coverage",
          "label": "Authorised zones",
          "format": "list"
        },
        {
          "key": "fireproofing",
          "label": "Fireproofing valid until",
          "format": "date"
        }
      ],
      "rules": [
        {
          "id": "RP-01",
          "title": "Respect the roof.",
          "description": "Declared weight must be 2,000 kg or less.",
          "type": "maxNumber",
          "field": "weight",
          "fieldLabel": "Declared weight",
          "maximum": 2000,
          "unit": "kg"
        },
        {
          "id": "RP-02",
          "title": "Check the coverage.",
          "description": "The authorised zones must include Rooftop. Ground permission alone is insufficient.",
          "type": "contains",
          "field": "coverage",
          "fieldLabel": "Authorised zones",
          "required": "Rooftop"
        },
        {
          "id": "RP-03",
          "title": "Fireproofing is mandatory.",
          "description": "The fireproofing certificate must be valid on the office date shown above.",
          "type": "dateNotBefore",
          "field": "fireproofing",
          "fieldLabel": "Fireproofing valid until"
        }
      ],
