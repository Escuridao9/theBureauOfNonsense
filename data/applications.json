    {
      "id": "travel",
      "name": "Department of Inconvenient Travel",
      "permit": "Temporary teleportation",
      "form": "TT-07",
      "date": "1984-10-08",
      "intro": "Arriving instantly still requires advance permission.",
      "memo": "A destination that sounds approximately correct is not an authorised destination.",
      "briefingTitle": "Mind the destination.",
      "briefing": "Today you will process temporary teleportation requests. Please note that the Moon remains outside our service area. The authorised destinations and luggage limit are printed in the rulebook.",
      "fields": [
        {
          "key": "destination",
          "label": "Requested destination",
          "format": "text"
        },
        {
          "key": "luggage",
          "label": "Declared luggage",
          "format": "number",
          "unit": "kg"
        },
        {
          "key": "certificate",
          "label": "Travel certificate valid until",
          "format": "date"
        },
        {
          "key": "carrier",
          "label": "Registered carrier",
          "format": "text"
        }
      ],
      "rules": [
        {
          "id": "TT-01",
          "title": "Stay inside the service area.",
          "description": "Only Old Town, Railway Station, and Post Office are authorised destinations.",
          "type": "oneOf",
          "field": "destination",
          "fieldLabel": "Requested destination",
          "allowed": [
            "Old Town",
            "Railway Station",
            "Post Office"
          ]
        },
        {
          "id": "TT-02",
          "title": "Pack sensibly.",
          "description": "Declared luggage must be 40 kg or less. This includes emotional baggage if packed.",
          "type": "maxNumber",
          "field": "luggage",
          "fieldLabel": "Declared luggage",
          "maximum": 40,
          "unit": "kg"
        },
        {
          "id": "TT-03",
          "title": "Travel on a valid certificate.",
          "description": "The travel certificate must be valid on the office date shown above.",
          "type": "dateNotBefore",
          "field": "certificate",
          "fieldLabel": "Travel certificate valid until"
        }
      ],
