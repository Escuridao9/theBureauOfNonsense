    {
      "id": "haunting",
      "name": "Department of After-Hours Phenomena",
      "permit": "Residential haunting",
      "form": "RH-09",
      "date": "1984-10-09",
      "intro": "The living have rights. So do the neighbours.",
      "memo": "A heartfelt moan remains a noise. Please measure it accordingly.",
      "briefingTitle": "The night shift, on paper.",
      "briefing": "Your final assignment is residential haunting. Four regulations now apply. Check the start time carefully: our permitted window crosses midnight, from 22:00 through 05:00. Being deceased does not exempt applicants from obtaining consent.",
      "fields": [
        {
          "key": "startTime",
          "label": "Proposed start time",
          "format": "time"
        },
        {
          "key": "noise",
          "label": "Declared noise level",
          "format": "number",
          "unit": "dB"
        },
        {
          "key": "consent",
          "label": "Property owner consent",
          "format": "boolean"
        },
        {
          "key": "duration",
          "label": "Requested duration",
          "format": "number",
          "unit": "minutes"
        }
      ],
      "rules": [
        {
          "id": "RH-01",
          "title": "Observe haunting hours.",
          "description": "The start time must be between 22:00 and 05:00, inclusive. The window crosses midnight.",
          "type": "timeWindow",
          "field": "startTime",
          "fieldLabel": "Proposed start time",
          "start": "22:00",
          "end": "05:00"
        },
        {
          "id": "RH-02",
          "title": "Keep the moaning down.",
          "description": "Declared noise must be 30 dB or less. Chains count.",
          "type": "maxNumber",
          "field": "noise",
          "fieldLabel": "Declared noise level",
          "maximum": 30,
          "unit": "dB"
        },
        {
          "id": "RH-03",
          "title": "Obtain consent.",
          "description": "The property owner must have provided consent. A frightened nod does not count.",
          "type": "equals",
          "field": "consent",
          "fieldLabel": "Property owner consent",
          "required": true
        },
        {
          "id": "RH-04",
          "title": "Do not overstay.",
          "description": "The requested haunting must last 60 minutes or less.",
          "type": "maxNumber",
          "field": "duration",
          "fieldLabel": "Requested duration",
          "maximum": 60,
          "unit": "minutes"
        }
      ],
